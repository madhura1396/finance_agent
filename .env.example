# .env.example
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ── Anthropic ──────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use for agent calls
# Options: claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-opus-4-7

# Maximum tokens per Claude response (increase for longer briefings)
MAX_TOKENS=1024

# ── Robinhood ──────────────────────────────────────────────────────────────
ROBINHOOD_USERNAME=you@example.com
ROBINHOOD_PASSWORD=your_robinhood_password

# MFA: either leave blank (no MFA), enter a static code, or enter your
# TOTP secret (the string shown when you set up authenticator app 2FA)
ROBINHOOD_MFA_CODE=

# ── Telegram ───────────────────────────────────────────────────────────────
# Create a bot via @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# Your personal chat ID — message @userinfobot on Telegram to find it
TELEGRAM_CHAT_ID=987654321

# ── Agent / MCP ────────────────────────────────────────────────────────────
# Symbols to include in historical price data when portfolio fetch is unavailable
# Comma-separated, no spaces
WATCHLIST_SYMBOLS=AAPL,TSLA,NVDA,MSFT

# Command the agent client uses to spawn the MCP server subprocess
MCP_SERVER_COMMAND=python -m mcp_server.server

# ── Scheduling ─────────────────────────────────────────────────────────────
# IANA timezone string — jobs run at 9am and 4pm in this timezone
TIMEZONE=America/New_York
